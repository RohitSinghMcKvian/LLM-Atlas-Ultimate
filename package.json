{
  "name": "llm-atlas",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20 <23"
  },
  "description": "LLM Atlas — the open ecosystem for everything LLM. Learn, research, compare, cost, and build in one workspace.",
  "scripts": {
    "postinstall": "node scripts/vendor-artifact-runtime.mjs",
    "prepare": "husky || true",
    "prebuild": "node scripts/vendor-artifact-runtime.mjs",
    "dev": "next dev",
    "dev:preview": "cross-env NEXT_DIST_DIR=.next-preview next dev -p 3105",
    "dev:verify": "cross-env NEXT_DIST_DIR=.next-verify next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "doctor": "node scripts/doctor.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@babel/standalone": "^7.29.7",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.110.0",
    "@webcontainer/api": "^1.6.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "framer-motion": "^11.15.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "lucide-react": "^0.469.0",
    "mammoth": "^1.13.0",
    "mermaid": "^11.16.0",
    "nanoid": "^5.0.9",
    "next": "^15.5.29",
    "next-themes": "^0.4.4",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^4.10.38",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^9.0.3",
    "recharts": "^2.15.0",
    "rehype-highlight": "^7.0.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.6.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/browser": "^4.3.5",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.10.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.6.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.1.6",
    "fake-indexeddb": "^6.2.7",
    "husky": "^9.1.7",
    "mathjs": "^15.2.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.187.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.9"
  }
}
