# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
# Glob covers any NEXT_DIST_DIR override (see next.config.mjs), not just the
# two build dirs the npm scripts happen to use today.
/.next*
/out/
next-env.d.ts

# production
/build

# Pinned artifact runtime, copied out of node_modules by
# scripts/vendor-artifact-runtime.mjs on postinstall/prebuild.
/public/artifact-runtime/

# misc
.DS_Store
*.pem
Thumbs.db
__pycache__/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env
.env*.local

# typescript
*.tsbuildinfo

# editor
.vscode/*
!.vscode/extensions.json
.idea
.vercel
